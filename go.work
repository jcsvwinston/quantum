go 1.26.6

toolchain go1.26.6

// Conveniencia de desarrollo: enlaza los tres productos de la suite para
// trabajarlos a la vez en local (mismo patrón que Orbit ya usa entre sus
// cuatro módulos). Este go.work NO se publica como dependencia y NO debe tener
// equivalente `replace` en los go.mod de los productos: en release cada módulo
// resuelve sus dependencias por tag real. La directiva `go` de arriba es la
// más alta entre los módulos del workspace (se actualiza con ellos; no repetir
// aquí el número, que ya quedó fósil una vez).
use (
	./nucleus
	./nucleus/examples/showcase_demo
	./nucleus/providers/ldap
	./orbit
	./orbit/agent
	./orbit/proto
	./orbit/quarkbridge
	./orbit/quarkdatasource
	./orbit/server
	./quark
)
